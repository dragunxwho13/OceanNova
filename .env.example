# ── OCEANNOVA environment ──────────────────────────────────────────────
# Nothing here is required for a plain Vercel deploy:
#   • the CNN engine loads trained weights from ml/weights/ (committed)
#   • ocean data comes from public NOAA CoastWatch ERDDAP + NDBC feeds (no key)

# Optional — natural-language explanations of CNN findings via Gemini 2.5 Flash.
# Without a key the UI falls back to honest model-generated summaries.
GEMINI_API_KEY=

# Optional — heavy remote FastAPI pipeline (285-band PACE L2 processing).
# When set, /api/hyperspectral/analyze and /api/real-* proxy to it INSTEAD of
# the in-repo TensorFlow.js engine.
ML_SERVICE_URL=

# Optional — NASA Earthdata (only needed by the remote service, never by the
# browser or the in-repo engine; these are sent server-side only).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# Optional — override where the engine looks for ml/weights artifacts.
OCEANNOVA_WEIGHTS_DIR=
